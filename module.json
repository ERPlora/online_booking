{
  "id": "online_booking",
  "name": "Online Booking",
  "version": "1.1.18",
  "description": "Let customers book online, then confirm, cancel or complete the booking and track no-shows.",
  "agent": {
    "description": "Manages online customer bookings: create, confirm, cancel, complete and track no-shows, and configure booking settings.",
    "keywords": [
      "booking",
      "reservation",
      "appointment",
      "confirm",
      "cancel",
      "schedule",
      "online"
    ]
  },
  "depends_on": [
    "customers"
  ],
  "permissions": [
    "online_booking.view_booking",
    "online_booking.change_booking",
    "online_booking.delete_booking",
    "online_booking.confirm_booking",
    "online_booking.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "online_booking.view_booking",
      "online_booking.change_booking",
      "online_booking.confirm_booking"
    ],
    "employee": [
      "online_booking.view_booking"
    ]
  },
  "navigation": [
    {
      "id": "bookings",
      "label": "Bookings",
      "icon": "calendar-outline",
      "component": "erp-online-booking-list"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-online-booking-settings"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_reference_counter.sql",
      "migrations/postgres/003_status_transition_guards.sql",
      "migrations/postgres/004_booking_window_guards.sql"
    ]
  },
  "queries": {
    "online_booking.bookings.list": {
      "permission": "online_booking.view_booking",
      "sql": "queries/bookings_list.sql",
      "list": {
        "search": [
          "booking_reference",
          "customer_name",
          "customer_email",
          "customer_phone",
          "service_name",
          "staff_name"
        ],
        "sort": [
          "id",
          "booking_reference",
          "customer_name",
          "customer_email",
          "customer_phone",
          "service_name",
          "staff_name",
          "booking_date",
          "booking_time",
          "duration_minutes",
          "status",
          "booking_type",
          "notes"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "booking_reference": {
            "op": "eq"
          },
          "customer_name": {
            "op": "like"
          },
          "customer_email": {
            "op": "like"
          },
          "customer_phone": {
            "op": "like"
          },
          "service_name": {
            "op": "like"
          },
          "staff_name": {
            "op": "like"
          },
          "booking_date": {
            "op": "range"
          },
          "booking_time": {
            "op": "eq"
          },
          "duration_minutes": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "booking_type": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all online bookings in the hub."
      }
    },
    "online_booking.bookings.get": {
      "permission": "online_booking.view_booking",
      "sql": "queries/booking_get.sql",
      "ai": {
        "description": "Retrieves the details of an online booking by its ID."
      }
    },
    "online_booking.settings.get": {
      "permission": "online_booking.view_booking",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the current configuration of the online booking module."
      }
    }
  },
  "commands": {
    "online_booking.bookings.create": {
      "permission": "online_booking.change_booking",
      "transaction": true,
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_booking"
      },
      "reads": [
        {
          "query": "online_booking.settings.get",
          "required": true
        }
      ],
      "schema": "schemas/booking_create.json",
      "emit": [
        "online_booking.booking.created"
      ],
      "ai": {
        "description": "Creates a new online booking for a customer (refuses without booking settings or outside the booking window)."
      }
    },
    "online_booking._booking_create": {
      "permission": "online_booking.change_booking",
      "transaction": true,
      "sql": [
        "commands/_bump_reference.sql",
        "commands/booking_create.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "statement": "commands/booking_create.sql",
        "error": "online_booking.outside_booking_window",
        "message": "That date and time are outside the booking window this business allows."
      }
    },
    "online_booking.bookings.confirm": {
      "permission": "online_booking.confirm_booking",
      "transaction": true,
      "sql": [
        "commands/booking_confirm.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "online_booking.cannot_confirm",
        "message": "This booking can no longer be confirmed: it is not pending any more."
      },
      "schema": "schemas/booking_confirm.json",
      "emit": [
        "online_booking.booking.confirmed"
      ],
      "ai": {
        "description": "Confirms a pending online booking awaiting approval."
      }
    },
    "online_booking.bookings.cancel": {
      "permission": "online_booking.change_booking",
      "transaction": true,
      "sql": [
        "commands/booking_cancel.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "online_booking.cannot_cancel",
        "message": "This booking can no longer be cancelled: it is already completed or cancelled."
      },
      "schema": "schemas/booking_cancel.json",
      "emit": [
        "online_booking.booking.cancelled"
      ],
      "ai": {
        "description": "Cancels an existing online booking."
      }
    },
    "online_booking.bookings.complete": {
      "permission": "online_booking.change_booking",
      "transaction": true,
      "sql": [
        "commands/booking_complete.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "online_booking.cannot_complete",
        "message": "This booking cannot be completed: it has not been confirmed."
      },
      "schema": "schemas/booking_complete.json",
      "emit": [
        "online_booking.booking.completed"
      ],
      "ai": {
        "description": "Marks a booking as completed after the service has been delivered."
      }
    },
    "online_booking.bookings.no_show": {
      "permission": "online_booking.change_booking",
      "transaction": true,
      "sql": [
        "commands/booking_no_show.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "online_booking.cannot_mark_no_show",
        "message": "This booking cannot be marked as a no-show in its current state."
      },
      "schema": "schemas/booking_no_show.json",
      "emit": [
        "online_booking.booking.no_show"
      ],
      "ai": {
        "description": "Records that the customer did not show up for their booking."
      }
    },
    "online_booking.bookings.delete": {
      "permission": "online_booking.delete_booking",
      "transaction": true,
      "sql": [
        "commands/booking_delete.sql"
      ],
      "schema": "schemas/booking_delete.json",
      "emit": [
        "online_booking.booking.deleted"
      ],
      "ai": {
        "description": "Permanently deletes an online booking from the system (destructive)."
      }
    },
    "online_booking.settings.upsert": {
      "permission": "online_booking.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "schema": "schemas/settings_upsert.json",
      "emit": [
        "online_booking.settings.updated"
      ],
      "ai": {
        "description": "Creates or updates the configuration of the online booking module."
      }
    },
    "online_booking._on_customer_merged": {
      "permission": "online_booking.change_booking",
      "transaction": true,
      "sql": [
        "commands/customer_merge_bookings.sql"
      ]
    }
  },
  "errors": {
    "online_booking.cannot_cancel": {},
    "online_booking.cannot_complete": {},
    "online_booking.cannot_confirm": {},
    "online_booking.cannot_mark_no_show": {},
    "online_booking.outside_booking_window": {},
    "online_booking.settings_missing": {},
    "online_booking.settings_unreadable": {}
  },
  "events": {
    "listen": {
      "customer.merged": {
        "command": "online_booking._on_customer_merged"
      }
    },
    "emits": [
      "online_booking.booking.cancelled",
      "online_booking.booking.completed",
      "online_booking.booking.confirmed",
      "online_booking.booking.created",
      "online_booking.booking.deleted",
      "online_booking.booking.no_show",
      "online_booking.settings.updated"
    ]
  },
  "ui": {
    "entry": "dist/online_booking.esm.js"
  }
}
